/* pages/about/about.wxss */
.about-container {
  min-height: 100vh;
  padding: 40rpx 36rpx;
  background-color: #090d16;
  display: flex;
  flex-direction: column;
}

.brand-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0 50rpx;
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  filter: drop-shadow(0 0 16rpx rgba(56, 189, 248, 0.5));
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 20rpx;
  letter-spacing: 1rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #38bdf8;
  margin-top: 8rpx;
}

.brand-ver {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.features-card {
  padding: 30rpx 28rpx;
  margin-bottom: 30rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.feature-detail {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  line-height: 1.4;
}

.action-card {
  padding: 10rpx 24rpx;
  margin-bottom: 40rpx;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 10rpx;
}

.action-label {
  font-size: 28rpx;
  color: #e2e8f0;
}

.action-val {
  font-size: 26rpx;
  color: #38bdf8;
}

.action-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.contact-btn {
  background: transparent;
  padding: 24rpx 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.action-arrow {
  font-size: 32rpx;
  color: #64748b;
}

.footer-meta {
  text-align: center;
  margin-top: auto;
  padding-bottom: 20rpx;
  font-size: 22rpx;
  color: #475569;
}
